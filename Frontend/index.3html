<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Marketplace</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Toast -->
    <div id="toast" class="toast"></div>

    <!-- AUTH SCREEN -->
    <section id="authScreen" class="auth-screen">
        <div class="auth-card">
            <div class="brand auth-brand">
                <div class="brand-logo">M</div>
                <div>
                    <h1>Mini<span>Market</span></h1>
                    <p>Simple. Modern. Yours.</p>
                </div>
            </div>

            <div class="auth-tabs">
                <button id="loginTab" class="auth-tab active">Login</button>
                <button id="signupTab" class="auth-tab">Create Account</button>
            </div>

            <!-- Login -->
            <form id="loginForm" class="auth-form">
                <div class="form-heading">
                    <h2>Welcome back</h2>
                    <p>Login to manage your marketplace products.</p>
                </div>

                <label>Email
                    <input id="loginEmail" type="email" placeholder="you@example.com" required>
                </label>

                <label>Password
                    <input id="loginPassword" type="password" placeholder="••••••••" required>
                </label>

                <button class="primary-btn full-btn" type="submit">
                    Login <span>→</span>
                </button>
            </form>

            <!-- Signup -->
            <form id="signupForm" class="auth-form hidden">
                <div class="form-heading">
                    <h2>Create your account ✨</h2>
                    <p>Join the marketplace and start selling products.</p>
                </div>

                <label>fullName
                    <input id="signupName" type="text" placeholder="Your name" required>
                </label>

                <label>Email
                    <input id="signupEmail" type="email" placeholder="you@example.com" required>
                </label>

                <label>Password
                    <input id="signupPassword" type="password" placeholder="Create a password" required>
                </label>

                <label>Confirm Password
                    <input id="signupConfirmPassword" type="password" placeholder="Confirm password" required>
                </label>

                <button class="primary-btn full-btn" type="submit">
                    Create Account <span>→</span>
                </button>
            </form>
        </div>
    </section>

    <!-- APP SCREEN -->
    <section id="appScreen" class="app-screen hidden">

        <header class="navbar">
            <div class="brand">
                <div class="brand-logo">M</div>
                <div>
                    <h1>Mini<span>Market</span></h1>
                    <p>Marketplace dashboard</p>
                </div>
            </div>

            <div class="nav-actions">
                <div class="user-chip">
                    <div id="userAvatar" class="avatar">U</div>
                    <div>
                        <strong id="navUserName">User</strong>
                        <small id="navUserEmail">user@email.com</small>
                    </div>
                </div>
                <button id="logoutBtn" class="logout-btn">Logout</button>
            </div>
        </header>

        <main class="dashboard">

            <section class="hero">
                <div>
                    <span class="eyebrow">SELL • MANAGE • GROW</span>
                    <h2>Everything you sell,<br><span>in one place.</span></h2>
                    <p>Create products, update your listings and keep your marketplace organized.</p>
                </div>

                <button id="openProductModal" class="primary-btn add-product-btn">
                    <span class="plus">+</span> Add Product
                </button>
            </section>

            <section class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon purple">▦</div>
                    <div>
                        <span>Total Products</span>
                        <strong id="totalProducts">0</strong>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon green">$</div>
                    <div>
                        <span>Average Price</span>
                        <strong id="averagePrice">0</strong>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon orange">●</div>
                    <div>
                        <span>Account</span>
                        <strong>Active</strong>
                    </div>
                </div>
            </section>

            <section class="products-section">
                <div class="section-head">
                    <div>
                        <span class="eyebrow">YOUR MARKETPLACE</span>
                        <h3>Products</h3>
                    </div>

                    <div class="section-actions">
                        <input id="searchInput" class="search-input" type="search" placeholder="Search products...">
                        <button id="refreshBtn" class="icon-btn" title="Refresh products">↻</button>
                    </div>
                </div>

                <div id="loadingState" class="loading-state hidden">
                    <div class="spinner"></div>
                    <p>Loading products...</p>
                </div>

                <div id="emptyState" class="empty-state hidden">
                    <div class="empty-icon">🛍️</div>
                    <h4>No products yet</h4>
                    <p>Create your first product and it will appear here.</p>
                    <button id="emptyAddBtn" class="primary-btn">Add First Product</button>
                </div>

                <div id="productsGrid" class="products-grid"></div>
            </section>
        </main>
    </section>

    <!-- PRODUCT MODAL -->
    <div id="productModal" class="modal hidden">
        <div class="modal-overlay" id="modalOverlay"></div>

        <div class="modal-card">
            <button id="closeModal" class="modal-close">×</button>

            <div class="modal-heading">
                <span class="eyebrow">PRODUCT MANAGEMENT</span>
                <h2 id="modalTitle">Create Product</h2>
                <p>Add the details of your product below.</p>
            </div>

            <form id="productForm">
                <input id="productId" type="hidden">

                <div class="form-grid">
                    <label class="full-field">
                        Product Name
                        <input id="productName" type="text" placeholder="e.g. Wireless Headphones" required>
                    </label>

                    <label>
                        Price
                        <input id="productPrice" type="number" min="0" step="0.01" placeholder="2500" required>
                    </label>

                    <label>
                        Category
                        <input id="productCategory" type="text" placeholder="Electronics" required>
                    </label>

                    <label class="full-field">
                        Image URL
                        <input id="productImage" type="url" placeholder="https://example.com/image.jpg">
                    </label>

                    <label class="full-field">
                        Description
                        <textarea id="productDescription" rows="4" placeholder="Write a short description..."
                            required></textarea>
                    </label>
                </div>

                <div class="modal-actions">
                    <button id="cancelModal" class="secondary-btn" type="button">Cancel</button>
                    <button id="saveProductBtn" class="primary-btn" type="submit">Create Product</button>
                </div>
            </form>
        </div>
    </div>

    <!-- DELETE MODAL -->
    <div id="deleteModal" class="modal hidden">
        <div class="modal-overlay"></div>

        <div class="confirm-card">
            <div class="danger-icon">!</div>
            <h2>Delete product?</h2>
            <p>This action cannot be undone. The product will be removed from the marketplace.</p>

            <div class="modal-actions">
                <button id="cancelDelete" class="secondary-btn">Cancel</button>
                <button id="confirmDelete" class="danger-btn">Delete</button>
            </div>
        </div>
    </div>

    <script src="cilent.js"></script>
</body>

</html>
